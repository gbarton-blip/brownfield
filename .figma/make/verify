#!/bin/bash
set -e

# Waits for the Vite dev server to start serving requests, then exits 0.
# Vite serves the app at the root path, so we poll that.

PORT="${PORT:-5173}"
HEALTHCHECK_URL="http://localhost:${PORT}/"
MAX_WAIT=120 # seconds
INTERVAL=2
ELAPSED=0

echo "Waiting for development server at ${HEALTHCHECK_URL}..."

while [ $ELAPSED -lt $MAX_WAIT ]; do
  if curl -sf "$HEALTHCHECK_URL" >/dev/null 2>&1; then
    echo "Dev server is up."
    exit 0
  fi
  sleep $INTERVAL
  ELAPSED=$((ELAPSED + INTERVAL))
done

echo "Error: Dev server did not start within ${MAX_WAIT}s"
exit 1
