#!/bin/bash
set -euo pipefail

URL="${FIGMA_MAKE_URL:-http://localhost:${PORT:-5173}}"
TIMEOUT=120
INTERVAL=2
ELAPSED=0

echo "Waiting for dev server at $URL ..."

while [ "$ELAPSED" -lt "$TIMEOUT" ]; do
  if curl -sf -o /dev/null "$URL"; then
    echo "Dev server is ready"
    exit 0
  fi
  sleep "$INTERVAL"
  ELAPSED=$((ELAPSED + INTERVAL))
done

echo "Dev server did not start within ${TIMEOUT}s"
exit 1
